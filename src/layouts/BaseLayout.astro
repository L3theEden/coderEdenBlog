---
import '@fontsource/fraunces/400.css';
import '@fontsource/fraunces/400-italic.css';
import '@fontsource/fraunces/500.css';
import '@fontsource/fraunces/500-italic.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '~/styles/global.css';
import { THEME_INIT } from '~/scripts/theme-init';
import Nav from '~/components/nav/Nav.astro';
import Footer from '~/components/nav/Footer.astro';
import defaultOgImage from '~/assets/hero-logo.png';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
}

const {
  title,
  description = 'CoderEden — notes from the workshop of a stolen fire.',
  ogImage = defaultOgImage.src,
  ogType = 'website',
  publishedTime,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · CoderEden</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="CoderEden" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- OG -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="CoderEden" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    <meta name="twitter:card" content="summary" />

    <!-- FOUC-safe theme -->
    <script is:inline set:html={THEME_INIT}></script>
  </head>
  <body class="min-h-screen">
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
