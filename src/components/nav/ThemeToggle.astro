---
---
<button
  type="button"
  data-theme-toggle
  aria-label="切换明暗主题"
  class="inline-flex items-center justify-center w-11 h-11 rounded-md text-muted hover:text-text hover:shadow-ring1 transition-[box-shadow,color] duration-200"
>
  <svg class="sun-icon w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
  </svg>
  <svg class="moon-icon w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
  </svg>
</button>

<script>
  // This component renders twice (desktop nav + mobile drawer); Astro dedupes
  // module scripts, so bind every instance and keep all icons in sync.
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');

  function syncIcons() {
    const dark = document.documentElement.getAttribute('data-theme') === 'dark';
    toggles.forEach((btn) => {
      btn.querySelector('.sun-icon')?.classList.toggle('hidden', dark);
      btn.querySelector('.moon-icon')?.classList.toggle('hidden', !dark);
    });
  }

  syncIcons();

  toggles.forEach((btn) => {
    btn.addEventListener('click', () => {
      const next =
        document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* localStorage unavailable */
      }
      syncIcons();
    });
  });
</script>
